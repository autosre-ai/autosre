# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
*.egg
dist/
build/
eggs/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.venv/
venv/
ENV/
env/
.virtualenvs/

# ─────────────────────────────────────────────────────────────────────────────
# Node.js / Frontend
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.nuxt/
.cache/
.turbo/
.vercel/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────────────
# IDEs & Editors
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ─────────────────────────────────────────────────────────────────────────────
# OS Files
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────────────────────
# Project-specific
# ─────────────────────────────────────────────────────────────────────────────
# Data & logs
data/
logs/
backups/
*.log
*.db
*.sqlite
*.sqlite3

# Docker volumes (if mounted locally)
volumes/
*.tar
*.gz

# Test artifacts
test-results/
playwright-report/
junit.xml

# Build artifacts
*.whl
site/

# Local config overrides
config.local.yaml
*.local.yaml
*.local.yml

# Kubernetes secrets (local)
*.kubeconfig
kubeconfig

# Generated docs
docs/_build/
site/

# Coverage reports
coverage/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.orig
