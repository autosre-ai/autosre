# Local Development with Ollama
# No cloud dependencies, runs entirely locally

# ==============================================================================
# LLM Provider
# ==============================================================================
OPENSRE_LLM_PROVIDER=ollama
OPENSRE_OLLAMA_HOST=http://localhost:11434
OPENSRE_OLLAMA_MODEL=llama3.1:8b

# ==============================================================================
# Local Infrastructure
# ==============================================================================

# Prometheus (from sandbox or local install)
OPENSRE_PROMETHEUS_URL=http://localhost:9090

# Kubernetes (using local kubeconfig)
# OPENSRE_KUBECONFIG=~/.kube/config
OPENSRE_K8S_NAMESPACES=default

# ==============================================================================
# Agent Behavior (relaxed for development)
# ==============================================================================
OPENSRE_REQUIRE_APPROVAL=false
OPENSRE_AUTO_APPROVE_LOW_RISK=true
OPENSRE_CONFIDENCE_THRESHOLD=0.5
OPENSRE_MAX_ITERATIONS=10
OPENSRE_TIMEOUT_SECONDS=300

# ==============================================================================
# Logging (verbose for debugging)
# ==============================================================================
OPENSRE_LOG_LEVEL=DEBUG
OPENSRE_LOG_FORMAT=text
