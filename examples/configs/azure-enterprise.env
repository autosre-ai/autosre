# Enterprise Configuration with Azure OpenAI
# Full compliance features, suitable for regulated environments

# ==============================================================================
# LLM Provider - Azure OpenAI
# ==============================================================================
OPENSRE_LLM_PROVIDER=azure
OPENSRE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
OPENSRE_AZURE_OPENAI_API_KEY=your-azure-api-key
OPENSRE_AZURE_OPENAI_DEPLOYMENT=gpt-4
OPENSRE_AZURE_OPENAI_API_VERSION=2024-02-01

# LLM Behavior
OPENSRE_LLM_RETRY_MAX_ATTEMPTS=3
OPENSRE_LLM_RETRY_BACKOFF_FACTOR=2.0
OPENSRE_LLM_CACHE_ENABLED=true
OPENSRE_LLM_CACHE_TTL_SECONDS=1800

# ==============================================================================
# Infrastructure
# ==============================================================================

# Prometheus (Azure Monitor compatible)
OPENSRE_PROMETHEUS_URL=http://prometheus.monitoring.svc:9090

# Kubernetes
OPENSRE_K8S_NAMESPACES=default,production,staging,compliance

# Loki
OPENSRE_LOKI_URL=http://loki.monitoring.svc:3100

# ==============================================================================
# Integrations
# ==============================================================================

# Slack
OPENSRE_SLACK_BOT_TOKEN=xoxb-your-bot-token
OPENSRE_SLACK_SIGNING_SECRET=your-signing-secret
OPENSRE_SLACK_CHANNEL=#incidents

# PagerDuty
OPENSRE_PAGERDUTY_API_KEY=your-pagerduty-key

# ==============================================================================
# Agent Behavior (strict for enterprise)
# ==============================================================================

# Always require human approval
OPENSRE_REQUIRE_APPROVAL=true

# Never auto-approve, even low-risk
OPENSRE_AUTO_APPROVE_LOW_RISK=false

# High confidence required
OPENSRE_CONFIDENCE_THRESHOLD=0.8

# Conservative limits
OPENSRE_MAX_ITERATIONS=5
OPENSRE_TIMEOUT_SECONDS=180

# ==============================================================================
# Logging (compliance-friendly)
# ==============================================================================
OPENSRE_LOG_LEVEL=INFO
OPENSRE_LOG_FORMAT=json
