# Production Configuration with OpenAI
# Suitable for cloud Kubernetes deployments

# ==============================================================================
# LLM Provider
# ==============================================================================
OPENSRE_LLM_PROVIDER=openai
OPENSRE_OPENAI_API_KEY=sk-your-api-key-here
OPENSRE_OPENAI_MODEL=gpt-4o-mini

# LLM Behavior
OPENSRE_LLM_RETRY_MAX_ATTEMPTS=3
OPENSRE_LLM_RETRY_BACKOFF_FACTOR=2.0
OPENSRE_LLM_CACHE_ENABLED=true
OPENSRE_LLM_CACHE_TTL_SECONDS=3600

# ==============================================================================
# Infrastructure
# ==============================================================================

# Prometheus
OPENSRE_PROMETHEUS_URL=http://prometheus.monitoring.svc:9090

# Kubernetes (uses in-cluster config by default)
OPENSRE_K8S_NAMESPACES=default,production,staging

# Loki for log aggregation
OPENSRE_LOKI_URL=http://loki.monitoring.svc:3100

# ==============================================================================
# Integrations
# ==============================================================================

# Slack notifications
OPENSRE_SLACK_BOT_TOKEN=xoxb-your-bot-token
OPENSRE_SLACK_SIGNING_SECRET=your-signing-secret
OPENSRE_SLACK_CHANNEL=#incidents

# PagerDuty integration
OPENSRE_PAGERDUTY_API_KEY=your-pagerduty-key

# ==============================================================================
# Agent Behavior (conservative for production)
# ==============================================================================
OPENSRE_REQUIRE_APPROVAL=true
OPENSRE_AUTO_APPROVE_LOW_RISK=false
OPENSRE_CONFIDENCE_THRESHOLD=0.7
OPENSRE_MAX_ITERATIONS=10
OPENSRE_TIMEOUT_SECONDS=300

# ==============================================================================
# Logging
# ==============================================================================
OPENSRE_LOG_LEVEL=INFO
OPENSRE_LOG_FORMAT=json
