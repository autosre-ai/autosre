# ==============================================================================
# AutoSRE Makefile
# ==============================================================================

.PHONY: help dev dev-slack stop restart logs logs-agent clean build test lint check

# Colors
GREEN := \033[0;32m
YELLOW := \033[0;33m
RED := \033[0;31m
NC := \033[0m

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "$(GREEN)%-15s$(NC) %s\n", $$1, $$2}'

# Development
dev: ## Start all services (PostgreSQL, Neo4j, Redis, LiteLLM, Agent, API, Web)
	@echo "$(GREEN)Starting AutoSRE development stack...$(NC)"
	docker compose -f docker-compose.prod.yml up -d
	@echo "$(GREEN)Services started!$(NC)"
	@echo "  API Gateway: http://localhost:8000"
	@echo "  Web UI: http://localhost:3000"
	@echo "  Neo4j Browser: http://localhost:7474"

dev-slack: ## Start all services + Slack bot
	@echo "$(GREEN)Starting AutoSRE with Slack integration...$(NC)"
	docker compose -f docker-compose.prod.yml --profile slack up -d

stop: ## Stop all services
	@echo "$(YELLOW)Stopping AutoSRE...$(NC)"
	docker compose -f docker-compose.prod.yml --profile slack down

restart: ## Restart all services
	@echo "$(YELLOW)Restarting AutoSRE...$(NC)"
	docker compose -f docker-compose.prod.yml restart

status: ## Show service status
	docker compose -f docker-compose.prod.yml ps

# Logs
logs: ## Follow all logs
	docker compose -f docker-compose.prod.yml logs -f

logs-agent: ## Follow agent logs
	docker compose -f docker-compose.prod.yml logs -f sre-agent

logs-api: ## Follow API gateway logs
	docker compose -f docker-compose.prod.yml logs -f api-gateway

# Build
build: ## Build all containers
	@echo "$(GREEN)Building AutoSRE containers...$(NC)"
	docker compose -f docker-compose.prod.yml build

build-agent: ## Build agent container only
	docker compose -f docker-compose.prod.yml build sre-agent

# Database
db-migrate: ## Run database migrations
	docker compose -f docker-compose.prod.yml exec sre-agent alembic upgrade head

db-revision: ## Create new migration
	@read -p "Migration message: " msg; \
	docker compose -f docker-compose.prod.yml exec sre-agent alembic revision --autogenerate -m "$$msg"

# Testing
test: ## Run tests
	@echo "$(GREEN)Running tests...$(NC)"
	uv run pytest tests/ -v --tb=short

test-cov: ## Run tests with coverage
	uv run pytest tests/ -v --cov=autosre --cov-report=html

# Linting
lint: ## Run linter
	uv run ruff check .

lint-fix: ## Fix linting issues
	uv run ruff check --fix .

format: ## Format code
	uv run ruff format .

typecheck: ## Run type checker
	uv run mypy autosre/

check: lint typecheck test ## Run all checks

# Cleanup
clean: ## Remove containers, volumes, and images
	@echo "$(RED)Cleaning up AutoSRE...$(NC)"
	docker compose -f docker-compose.prod.yml --profile slack down -v --rmi local
	rm -rf .pytest_cache .ruff_cache .mypy_cache __pycache__

clean-volumes: ## Remove data volumes only
	docker volume rm autosre-postgres-data autosre-neo4j-data autosre-redis-data || true

# Installation
install: ## Install dependencies
	uv sync

install-dev: ## Install dev dependencies
	uv sync --extra dev

# Production
prod-up: ## Start production stack
	docker compose -f docker-compose.prod.yml up -d

prod-down: ## Stop production stack
	docker compose -f docker-compose.prod.yml down
