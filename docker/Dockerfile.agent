# ==============================================================================
# AutoSRE Agent - Production Dockerfile
# ==============================================================================
# Multi-stage build for minimal, secure production image

# Stage 1: Build
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Create virtual environment and install dependencies
RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN uv pip install --no-cache .

# Stage 2: Production
FROM python:3.12-slim AS production

# Create non-root user
RUN groupadd -r agent && useradd -r -g agent -d /home/agent -s /sbin/nologin agent

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Copy application code
COPY autosre/ ./autosre/
COPY skills/ ./skills/

# Create necessary directories
RUN mkdir -p /home/agent/.cache /home/agent/.autosre \
    && chown -R agent:agent /home/agent /app

# Switch to non-root user
USER agent

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Run the agent server
CMD ["python", "-m", "uvicorn", "autosre.server:app", "--host", "0.0.0.0", "--port", "8000"]
