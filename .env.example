# ═══════════════════════════════════════════════════════════════════════════════
# AutoSRE V2 — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and update the values
# DO NOT commit .env to version control
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────────────────

# Environment: development, staging, production
AUTOSRE_ENV=development

# Debug mode (disable in production)
AUTOSRE_DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR
AUTOSRE_LOG_LEVEL=INFO

# Log format: console, json
AUTOSRE_LOG_FORMAT=console

# Secret key for JWT tokens and encryption (generate with: openssl rand -hex 32)
AUTOSRE_SECRET_KEY=change-me-to-random-string

# ─────────────────────────────────────────────────────────────────────────────
# API Settings
# ─────────────────────────────────────────────────────────────────────────────

# API server port
API_PORT=8000

# Number of worker processes (production)
API_WORKERS=4

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ─────────────────────────────────────────────────────────────────────────────
# UI Settings
# ─────────────────────────────────────────────────────────────────────────────

# UI server port
UI_PORT=3000

# Public API URL (for browser requests)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autosre
POSTGRES_PASSWORD=autosre_local
POSTGRES_DB=autosre

# Full database URL (overrides individual settings)
# DATABASE_URL=postgresql+asyncpg://autosre:autosre_local@localhost:5432/autosre

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Full Redis URL (overrides individual settings)
# REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# LLM Configuration
# ─────────────────────────────────────────────────────────────────────────────

# LLM provider: openai, anthropic, litellm
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LiteLLM (for multi-provider routing)
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Model temperature (0.0 - 2.0)
LLM_TEMPERATURE=0.7

# Max tokens per response
LLM_MAX_TOKENS=4096

# ─────────────────────────────────────────────────────────────────────────────
# Kubernetes Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Path to kubeconfig file
# KUBECONFIG=~/.kube/config

# Default namespace for operations
K8S_NAMESPACE_DEFAULT=default

# Operation timeout (seconds)
K8S_OPERATION_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────────────

# Enable Kubernetes operations
FEATURE_K8S_OPERATIONS=true

# Enable auto-remediation (use with caution!)
FEATURE_AUTO_REMEDIATION=false

# Enable metrics export
FEATURE_METRICS_EXPORT=true

# ─────────────────────────────────────────────────────────────────────────────
# External Integrations
# ─────────────────────────────────────────────────────────────────────────────

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_DEFAULT_CHANNEL=

# PagerDuty
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# GitHub
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring & Observability
# ─────────────────────────────────────────────────────────────────────────────

# Prometheus metrics endpoint
PROMETHEUS_URL=

# Grafana
GRAFANA_URL=
GRAFANA_API_KEY=

# Datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# Sentry (error tracking)
SENTRY_DSN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=autosre

# ─────────────────────────────────────────────────────────────────────────────
# Logging Backends
# ─────────────────────────────────────────────────────────────────────────────

# Elasticsearch
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=autosre-logs

# Loki
LOKI_URL=

# Coralogix
CORALOGIX_API_KEY=
CORALOGIX_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# Cloud Providers
# ─────────────────────────────────────────────────────────────────────────────

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
