# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !).

.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/

# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~

# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Test files
tests/
*_test.yaml

# Documentation source
docs/

# CI files
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
Makefile

# Other
*.md
!README.md
LICENSE
