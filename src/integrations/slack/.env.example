# ============================================
# AutoSRE Slack Bot Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ============================================
# Slack Credentials (Required)
# ============================================

# Bot OAuth Token (xoxb-...)
# Found in: Slack App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token for Socket Mode (xapp-...)
# Found in: Slack App → Basic Information → App-Level Tokens
# Requires: connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token

# Signing Secret for request verification
# Found in: Slack App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# ============================================
# AutoSRE API Connection
# ============================================

# Base URL for the AutoSRE API
# Default: http://localhost:8000 for local development
# In Docker: http://autosre-api:8000
AUTOSRE_API_URL=http://localhost:8000

# API authentication token (if required)
# AUTOSRE_API_TOKEN=

# ============================================
# Logging & Monitoring
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json, console
LOG_FORMAT=json

# Health check port (for container health checks)
HEALTH_PORT=8080

# ============================================
# Feature Flags (Optional)
# ============================================

# Enable debug mode (more verbose logging)
# DEBUG=false

# Enable streaming updates to Slack
# ENABLE_STREAMING=true

# Maximum concurrent investigations per channel
# MAX_CONCURRENT_INVESTIGATIONS=5
