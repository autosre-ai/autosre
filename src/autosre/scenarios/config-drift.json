  "ai_insight": "Analyzing collected evidence... Pattern detected: Configuration drift after rolling deployment. 2 of 5 user-service pods are running with stale AUTH_SECRET_KEY (v2) while 3 pods have updated key (v3). Requests randomly hitting v2 pods fail JWT validation. This explains the intermittent nature of auth failures. Confidence level: HIGH.",

  "hypotheses": [
    {"title": "Configuration drift: AUTH_SECRET_KEY mismatch", "confidence": 0.88, "status": "HIGH", "color": "green"},
    {"title": "Vault secret rotation incomplete", "confidence": 0.54, "status": "MEDIUM", "color": "yellow"},
    {"title": "JWT library version mismatch", "confidence": 0.12, "status": "LOW", "color": "dim"},
    {"title": "Database session table corruption", "confidence": 0.04, "status": "RULED OUT", "color": "dim"}
  ],

  "correlations": [
    {"evidence": "2 pods have different AUTH_SECRET_KEY", "status": "CONFIRMED", "color": "green"},
    {"evidence": "Failures correlate with traffic to v2 pods", "status": "CONFIRMED", "color": "green"},
    {"evidence": "Rolling update terminated early", "status": "CONFIRMED", "color": "green"},
    {"evidence": "JWT library functioning correctly", "status": "RULED OUT", "color": "dim"}
  ],

  "root_cause": "Configuration drift: AUTH_SECRET_KEY mismatch",

  "recommendations": [
    "Sync AUTH_SECRET_KEY across all user-service pods",
    "Migrate secrets to HashiCorp Vault with versioning",
    "Add config consistency check to deployment pipeline",
    "Implement config drift detection alerts"
  ],

  "evidence_summary": {
    "error_rate": "18.4% auth failures (intermittent)",
    "threshold": "0.1%",
