    {"action": "Analyzing config state", "result": "Config mismatch detected across 2/5 pods"}
  ],

  "data_sources": [
    {"name": "📊 Prometheus", "query": "sum(rate(auth_failures_total{service=\"user-service\"}[5m])) by (pod)", "duration": 0.3},
    {"name": "📜 Elasticsearch", "query": "service:user-service AND (JWT OR auth OR signature)", "duration": 0.4},
    {"name": "☸️  Kubernetes", "query": "kubectl get pods -l app=user-service -o jsonpath='{.items[*].metadata.name}'", "duration": 0.2},
    {"name": "🔐 Vault", "query": "vault kv get -version=2 secret/user-service/AUTH_SECRET_KEY", "duration": 0.3}
  ],

  "metrics": [
    {"name": "Auth Failure Rate", "current": "18.4%", "baseline": "0.01%", "status": "🔴 HIGH", "status_color": "red"},
    {"name": "JWT Validation Errors", "current": "156/min", "baseline": "2/min", "status": "🔴 CRITICAL", "status_color": "red"},
    {"name": "Config Version", "current": "Mixed (v2/v3)", "baseline": "v3", "status": "⚠️  DRIFT", "status_color": "yellow"},
    {"name": "Pods with v2 Config", "current": "2/5", "baseline": "0/5", "status": "⚠️  STALE", "status_color": "yellow"},
    {"name": "User Complaints", "current": "47", "baseline": "0", "status": "⚠️  ELEVATED", "status_color": "yellow"}
  ],

  "logs": [
    {"level": "ERROR", "timestamp": "{now-3h}", "message": "JWT signature verification failed: key mismatch"},
