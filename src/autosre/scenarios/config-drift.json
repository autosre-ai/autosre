{
  "id": "config-drift",
  "name": "Configuration Drift",
  "alert": "Intermittent authentication failures: user-service",
  "service": "user-service",
  "severity": "medium",
  "description": "Environment variable mismatch between pods",

  "service_topology": {
    "target": "user-service",
    "dependencies": [
      {"name": "postgres-users", "type": "database"},
      {"name": "redis-sessions", "type": "cache"},
      {"name": "vault", "type": "secrets", "note": "secret management"}
    ],
    "upstream": [
      {"name": "api-gateway", "type": "gateway"},
      {"name": "auth-service", "type": "service"}
    ]
  },

  "context_items": [
    {"action": "Fetching service topology", "result": "Found 3 dependencies for user-service"},
    {"action": "Loading alert history", "result": "Retrieved 234 auth failures from last 4h"},
