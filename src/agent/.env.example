# AutoSRE Agent Environment Configuration
# Copy to .env and fill in your values

# LiteLLM Proxy (for multi-provider LLM access)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-your-key

# Or direct OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Default model (used when team config is unavailable)
DEFAULT_MODEL=claude-sonnet-4-20250514

# Investigation limits
MAX_ITERATIONS=3
SUBAGENT_MAX_REACT_LOOPS=25

# Memory Service (optional)
# MEMORY_SERVICE_URL=http://localhost:8081

# Neo4j Knowledge Graph (optional)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Config Service (optional)
# CONFIG_SERVICE_URL=http://localhost:8080
# TEAM_TOKEN=
# AUTOSRE_TENANT_ID=
# AUTOSRE_TEAM_ID=

# Disable specific subagents (comma-separated)
# DISABLED_SUBAGENTS=traces
